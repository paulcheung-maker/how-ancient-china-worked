---
import BaseLayout from './BaseLayout.astro';
interface Props {
  title: string; description: string; publishedAt: Date; updatedAt?: Date; section: string;
  related?: { title: string; description: string; href: string }[];
}
const { title, description, publishedAt, updatedAt, section, related = [] } = Astro.props;
const site = Astro.site ?? Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, site).toString();
const sectionPath = `/${section.toLowerCase().replace(/\s+/g, '-')}/`;
const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'long', day: 'numeric' });
const schema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: title, description,
  datePublished: publishedAt.toISOString(), dateModified: (updatedAt ?? publishedAt).toISOString(),
  mainEntityOfPage: canonicalURL, author: { '@type': 'Organization', name: 'How Ancient China Worked' },
  publisher: { '@type': 'Organization', name: 'How Ancient China Worked' },
};
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).toString() },
  { '@type': 'ListItem', position: 2, name: section, item: new URL(sectionPath, site).toString() },
  { '@type': 'ListItem', position: 3, name: title, item: canonicalURL },
] };
---
<BaseLayout title={`${title} | How Ancient China Worked`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  <article class="article shell narrow">
    <p class="eyebrow"><a href={sectionPath}>{section}</a></p>
    <h1>{title}</h1>
    <p class="dek">{description}</p>
    <p class="byline">Published <time datetime={publishedAt.toISOString()}>{fmt.format(publishedAt)}</time>{updatedAt && <> · Updated <time datetime={updatedAt.toISOString()}>{fmt.format(updatedAt)}</time></>}</p>
    <div class="prose"><slot /></div>
  </article>
  {related.length > 0 && <section class="shell narrow section">
    <div class="section-heading"><p class="eyebrow">Keep reading</p><h2>Related questions</h2></div>
    <div class="card-grid">
      {related.map((item) => <a class="card" href={item.href}><h3>{item.title}</h3><p>{item.description}</p><span>Read article →</span></a>)}
    </div>
  </section>}
</BaseLayout>
