---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const cleanId = (id: string) => id.replace(/\.md$/, '');
---
<BaseLayout title="How Ancient China Worked" description="Clear answers to practical questions about life, names, government and society in imperial China.">
  <section class="hero shell">
    <p class="eyebrow">Imperial China, clearly explained</p>
    <h1>How Ancient China Worked</h1>
    <p>Clear answers to practical questions about life, names, government and society in imperial China.</p>
    <a class="button" href="/daily-life/">Explore daily life</a>
  </section>
  <section class="shell section">
    <div class="section-heading"><p class="eyebrow">Browse by topic</p><h2>Start with a practical question</h2></div>
    <div class="card-grid">
      <a class="card" href="/daily-life/"><p class="eyebrow">Daily life</p><h3>Eating, homes, and family life</h3><p>What people ate, where they lived, and how households and marriages worked.</p><span>Explore Daily Life →</span></a>
      <a class="card" href="/names/"><p class="eyebrow">Names</p><h3>Names and identity</h3><p>Personal names, courtesy names, surnames, family naming, and historical records.</p><span>Explore Names →</span></a>
      <a class="card" href="/government/"><p class="eyebrow">Government</p><h3>How the empire governed</h3><p>Emperors, officials, taxation, household registration, and local administration.</p><span>Explore Government →</span></a>
    </div>
  </section>
  <section class="shell section">
    <div class="section-heading"><p class="eyebrow">Recent answers</p><h2>Read next</h2></div>
    <div class="card-grid">
      {articles.slice(0, 6).map((article) => <a class="card" href={`/${article.data.section.toLowerCase().replace(/\s+/g, '-')}/${cleanId(article.id)}/`}><p class="eyebrow">{article.data.section}</p><h3>{article.data.title}</h3><p>{article.data.description}</p><span>Read article →</span></a>)}
    </div>
  </section>
</BaseLayout>
